# Local UI preview root target. The authenticated routes always verify /me.
APP_ROOT_PREVIEW=login

# Server-only API and Admin origins. Set these per environment.
VITE_API_BASE_URL=https://api.example.test
NEXT_ADMIN_ORIGIN=http://localhost:3000
# Override only if Laravel SESSION_COOKIE differs from mosaiq-session.
# ADMIN_SESSION_COOKIE=mosaiq-session
